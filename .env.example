# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=directory-pipeline

# --- OpenSearch ---
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_ALIAS=companies

# --- Targets (mock services ship with the repo; swap for real hosts) ---
DIRECTORY_BASE_URL=http://localhost:8081
ENRICHMENT_BASE_URL=http://localhost:8082
ENRICHMENT_API_KEY=demo-key

# --- Politeness / throughput ---
# CRAWL_RPS is a ceiling, not a target: a host's robots.txt Crawl-delay or
# Request-rate lowers it further, per host, and never raises it.
CRAWL_RPS=5.0
CRAWL_BURST=10
CRAWL_CONCURRENCY=8
ENRICH_RPS=10.0
ENRICH_CONCURRENCY=16

# --- robots.txt ---
# On by default. Turning it off is a deliberate choice that is only defensible
# against a host you own; the enrichment provider turns it off in code, because
# an authenticated API call under a contract is not crawling published content.
OBEY_ROBOTS=true
ROBOTS_CACHE_TTL_S=3600

# --- Identity ---
# The product token here is what selects our group in a site's robots.txt, and
# the contact URL is how an operator asks this crawler to stop. Point both at
# something real before crawling anything you do not own.
USER_AGENT=directory-pipeline/0.1 (+https://example.com/bot; contact=devs@example.com)

# Browser-string rotation. Refused at startup while OBEY_ROBOTS=true, because
# reading the rules written for `directory-pipeline` and then announcing
# yourself as Chrome is a contradiction. Useful against your own mocks.
ROTATE_USER_AGENTS=false

# --- Proxy rotation (comma-separated; empty = direct) ---
PROXY_POOL=

# --- Model-assisted extraction ---
# Leave ANTHROPIC_API_KEY empty to use the deterministic DOM extractor (no API calls).
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5
EXTRACTION_MODE=auto
