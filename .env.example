# --- Temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=directory-pipeline

# --- OpenSearch ---
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_ALIAS=companies

# --- Targets (mock services ship with the repo; swap for real hosts) ---
DIRECTORY_BASE_URL=http://localhost:8081
ENRICHMENT_BASE_URL=http://localhost:8082
ENRICHMENT_API_KEY=demo-key

# --- Politeness / throughput ---
CRAWL_RPS=5.0
CRAWL_BURST=10
CRAWL_CONCURRENCY=8
ENRICH_RPS=10.0
ENRICH_CONCURRENCY=16

# --- Proxy rotation (comma-separated; empty = direct) ---
PROXY_POOL=

# --- Agentic extraction ---
# Leave ANTHROPIC_API_KEY empty to use the deterministic DOM extractor (no API calls).
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5
EXTRACTION_MODE=auto
